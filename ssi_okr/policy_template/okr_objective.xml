<odoo>
<record id="okr_objective_policy_template" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_okr_objective" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','okr_objective'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- ready -->
<record id="okr_objective_policy_template_detail_ready" model="policy.template_detail">
    <field name="template_id" ref="okr_objective_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','okr_objective'),('name','=','ready_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','okr_objective'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('okr_objective_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

