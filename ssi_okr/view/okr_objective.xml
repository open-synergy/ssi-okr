<odoo>
<record id="okr_objective_view_search" model="ir.ui.view">
    <field name="name">okr_objective - search</field>
    <field name="model">okr_objective</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
    <data>
    </data>
    </field>
</record>

<record id="okr_objective_view_tree" model="ir.ui.view">
    <field name="name">okr_objective - tree</field>
    <field name="model">okr_objective</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
    <data>
        <xpath expr="//field[@name='company_id']" position="after">
            <field name="partner_id" widget="many2one_avatar" />
            <field name="contact_partner_id" widget="many2one_avatar" optional="hide" />
            <field name="objective" />
            <field name="date_start" />
            <field name="date_end" />
            <field name="key_result_count" />
            <field name="open_key_result_count" string="∑ Open" optional="hide" />
            <field name="percentage_open" string="% Open" widget="percentage" />
            <field name="done_key_result_count" string="∑ Done" optional="hide" />
            <field name="percentage_completed" string="% Done" widget="percentage" />
            <field name="cancel_key_result_count" string="∑ Cancel" optional="hide" />
            <field name="percentage_cancel" string="% Cancel" widget="percentage" />
            <field
                        name="terminate_key_result_count"
                        string="∑ Terminate"
                        optional="hide"
                    />
            <field
                        name="percentage_terminate"
                        string="% Terminate"
                        widget="percentage"
                    />
        </xpath>
    </data>
    </field>
</record>

<record id="okr_objective_view_form" model="ir.ui.view">
    <field name="name">okr_objective - form</field>
    <field name="model">okr_objective</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
    <data>
        <xpath expr="//div[@name='button_box']" position="inside">
            <button
                        name="action_open_key_result"
                        type="object"
                        class="oe_stat_button"
                        groups="ssi_okr.okr_objective_viewer_group"
                        icon="fa-list"
                    >
                <div class="o_form_field o_stat_info">
                    <span class="o_stat_value">
                        <field name="key_result_count" />
                    </span>
                    <span class="o_stat_text">Key Results</span>
                </div>
            </button>
        </xpath>
        <xpath expr="//field[@name='user_id']" position="after">
            <field name="partner_id" widget="many2one_avatar" />
            <field name="allowed_contact_ids" widget="many2many_tags" invisible="1" />
            <field
                        name="contact_partner_id"
                        domain="[('id', 'in', allowed_contact_ids)]"
                        widget="many2one_avatar"
                    />
        </xpath>
        <xpath expr="//group[@name='header_right']" position="inside">
            <field name="date" />
            <field name="date_start" />
            <field name="date_end" />
        </xpath>
        <xpath expr="//group[@name='header_center']" position="inside">
            <field name="objective" />
        </xpath>
        <xpath expr="//page[1]" position="before">
            <page string="Key Results">
                <group name="key_result_1" colspan="4" col="2">
                    <group name="key_result_1_left" colspan="1" col="2" string="Count">
                        <field name="key_result_count" string="Total" />
                        <field name="open_key_result_count" string="Open" />
                        <field name="done_key_result_count" string="Done" />
                        <field name="cancel_key_result_count" string="Cancel" />
                        <field name="terminate_key_result_count" string="Terminate" />
                    </group>
                    <group
                                name="key_result_1_right"
                                colspan="1"
                                col="2"
                                string="Percentage"
                            >
                        <field
                                    name="percentage_open"
                                    string="Open"
                                    widget="percentage"
                                />
                        <field
                                    name="percentage_completed"
                                    string="Done"
                                    widget="percentage"
                                />
                        <field
                                    name="percentage_cancel"
                                    string="Cancel"
                                    widget="percentage"
                                />
                        <field
                                    name="percentage_terminate"
                                    string="Terminate"
                                    widget="percentage"
                                />
                    </group>
                </group>
            </page>
        </xpath>
    </data>
    </field>
</record>

<record id="okr_objective_action" model="ir.actions.act_window">
    <field name="name">Objectives</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">okr_objective</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="okr_objective_menu"
        name="Objectives"
        action="okr_objective_action"
        parent="ssi_project.menu_project_root_menu"
        sequence="30"
    />
</odoo>
