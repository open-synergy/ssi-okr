<odoo>
<record id="okr_key_result_view_search" model="ir.ui.view">
    <field name="name">okr_key_result - search</field>
    <field name="model">okr_key_result</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
    <data>
    </data>
    </field>
</record>

<record id="okr_key_result_view_tree" model="ir.ui.view">
    <field name="name">okr_key_result - tree</field>
    <field name="model">okr_key_result</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
    <data>
        <xpath expr="//field[@name='company_id']" position="after">
            <field name="partner_id" widget="many2one_avatar" />
            <field name="contact_partner_id" widget="many2one_avatar" optional="hide" />
            <field name="objective_id" />
            <field name="key_result" />
            <field name="date_deadline" />
            <field name="target_value" />
            <field name="uom_id" />
            <field name="actual_value" />
            <field name="percentage" widget="percentage" />
        </xpath>
    </data>
    </field>
</record>

<record id="okr_key_result_view_form" model="ir.ui.view">
    <field name="name">okr_key_result - form</field>
    <field name="model">okr_key_result</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
    <data>
        <xpath expr="//field[@name='user_id']" position="after">
            <field name="partner_id" widget="many2one_avatar" />
            <field name="allowed_contact_ids" widget="many2many_tags" invisible="1" />
            <field
                        name="contact_partner_id"
                        domain="[('id', 'in', allowed_contact_ids)]"
                        widget="many2one_avatar"
                    />
            <field name="objective_id" domain="[('partner_id', '=', partner_id)]" />
        </xpath>
        <xpath expr="//group[@name='header_right']" position="inside">
            <field name="date" />
            <field name="date_deadline" />
        </xpath>
        <xpath expr="//group[@name='header_center']" position="inside">
            <field name="key_result" />
        </xpath>
        <xpath expr="//page[1]" position="before">
            <page name="target_measurement" string="Target &amp; Measurement">
                <group name="target_measurement_1" colspan="4" col="2">
                    <field name="target_value" />
                    <field name="uom_id" />
                    <field name="actual_value" />
                    <field name="percentage" widget="percentage" />
                </group>
                <field name="measurement_ids">
                    <tree editable="bottom">
                        <field name="date" />
                        <field name="user_id" widget="many2one_avatar" />
                        <field name="value" />
                        <field name="note" />
                    </tree>
                </field>
            </page>
        </xpath>
    </data>
    </field>
</record>

<record id="okr_key_result_action" model="ir.actions.act_window">
    <field name="name">Key Results</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">okr_key_result</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="okr_key_result_menu"
        name="Key Results"
        action="okr_key_result_action"
        parent="ssi_project.menu_project_root_menu"
        sequence="40"
    />
</odoo>
