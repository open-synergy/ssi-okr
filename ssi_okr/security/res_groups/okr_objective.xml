<odoo>
<record id="okr_objective_viewer_group" model="res.groups">
    <field name="name">Viewer</field>
    <field name="category_id" ref="okr_objective_workflow" />
</record>
<record id="okr_objective_user_group" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="okr_objective_workflow" />
    <field name="implied_ids" eval="[(6,0,[ref('okr_objective_viewer_group')])]" />
</record>
<record id="okr_objective_validator_group" model="res.groups">
    <field name="name">Validator</field>
    <field name="category_id" ref="okr_objective_workflow" />
    <field name="implied_ids" eval="[(6,0,[ref('okr_objective_user_group')])]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

<record id="okr_objective_company_group" model="res.groups">
    <field name="name">Company</field>
    <field name="category_id" ref="okr_objective_data_ownership" />
</record>
<record id="okr_objective_child_company_group" model="res.groups">
    <field name="name">Company and All Child Companies</field>
    <field name="category_id" ref="okr_objective_data_ownership" />
    <field name="implied_ids" eval="[(6,0,[ref('okr_objective_company_group')])]" />
</record>
<record id="okr_objective_all" model="res.groups">
    <field name="name">All</field>
    <field name="category_id" ref="okr_objective_data_ownership" />
    <field name="implied_ids" eval="[(6,0,[ref('okr_objective_company_group')])]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>
</odoo>
