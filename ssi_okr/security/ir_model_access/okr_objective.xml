<odoo>
<record id="okr_objective_all_access" model="ir.model.access">
    <field name="name">okr_objective - all</field>
    <field name="model_id" ref="model_okr_objective" />
    <field name="group_id" eval="False" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
</record>
<record id="okr_objective_user_access" model="ir.model.access">
    <field name="name">okr_objective - user</field>
    <field name="model_id" ref="model_okr_objective" />
    <field name="group_id" ref="okr_objective_user_group" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
</record>
</odoo>
